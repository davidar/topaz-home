[Unit]
Description=Dropbox (Flatpak)
# Started by the graphical session, not the user manager: with lingering
# the manager starts at boot, minutes before a login brings up a tray, and
# a daemon launched without one never shows its icon.
After=graphical-session.target

[Service]
Type=oneshot
# Dropbox's tray icon names sandbox-only IconThemePath icons; sync them into
# the user icon theme so the host panel can render them (self-heals after
# Dropbox updates, which change the versioned path).
ExecStartPre=%h/.local/bin/topaz-dropbox-icons
# Wait for a StatusNotifier tray to exist so the icon registers, but never
# block on it for long (GNOME-without-appindicator sessions have none).
ExecStartPre=-/bin/sh -c 'timeout 30 sh -c "until busctl --user status org.kde.StatusNotifierWatcher >/dev/null 2>&1; do sleep 1; done"'
# `dropbox start` hands the daemon to the Flatpak session helper (it lives in
# an app scope outside this unit) and exits — hence oneshot. A real restart
# needs `flatpak kill com.dropbox.Client` first, not systemctl; the watchdog
# timer does that when the daemon is gone or the Flatpak has updated.
ExecStart=/usr/bin/flatpak run --command=/app/bin/dropbox com.dropbox.Client start
# Remember which deploy this daemon came from, for the watchdog's staleness check.
ExecStartPost=%h/.local/bin/topaz-dropbox-watchdog record

[Install]
WantedBy=graphical-session.target
