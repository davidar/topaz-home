[Unit]
Description=KDE Connect daemon (kdeconnect distrobox)
# Session service: kdeconnectd is a QGuiApplication and aborts without a
# display, and the display variables only reach the user manager once a
# graphical session is up. WantedBy=default.target used to start it at
# boot, before any session existed — five SIGABRTs into the start limit.
# PartOf= stops it with the session teardown so each login gets a daemon
# holding the live compositor's socket, not a dead one.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# Type=dbus + BusName: the unit counts as up once the daemon owns the
# name, and D-Bus activation (SystemdService= in the activation file)
# starts this unit instead of racing a second daemon against it.
Type=dbus
BusName=org.kde.kdeconnect
# The launcher enters the `kdeconnect` distrobox (just kdeconnect
# install), sweeping stale sshfs mounts first; the container shares the
# host session bus and $HOME, so pairing state (~/.config/kdeconnect),
# the indicator, and notifications behave exactly as the baked daemon.
ExecStart=%h/.local/bin/topaz-kdeconnectd
Restart=on-failure

[Install]
WantedBy=graphical-session.target
