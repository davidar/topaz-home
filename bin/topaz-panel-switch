#!/usr/bin/bash
# Make opal's bar the panel on COSMIC-on-niri, cosmic-panel disabled but not
# removed — the interim before topaz-os's niri-topaz-session branch does the
# same in the image (opal: docs/packages/BAR-R.md, R5; docs/BAR.md, B3).
#
#   topaz-panel-switch           cosmic-panel and cosmic-notifications out,
#                                opal-bar at the top of the screen
#   topaz-panel-switch --undo    cosmic-panel back, the bar at the bottom
#   topaz-panel-switch --status  what is live now (read-only)
#   topaz-panel-switch --drop-copy
#                                remove the tunables copy once the shipped
#                                default is EDGE_TOP (refuses otherwise)
#
# How the panel stays away: cosmic-session respawns a child that exits, by
# PATH lookup, with ~/.local/bin ahead of /usr/bin on the session's PATH. A
# `cosmic-panel` there that only sleeps is what cosmic-session finds on the
# respawn, this login and the next. cosmic-notifications gets the same shim
# so `opal-notify` keeps org.freedesktop.Notifications uncontested. The two
# panel watchdogs and the shell watchdog assert cosmic-panel, so they are
# disabled first; `systemctl mask` is not available to us because the unit
# files live in ~/.config/systemd/user (topaz-home copies them there), and
# `disable` survives `just apply`, which copies and reloads but never
# enables. The bar's edge is one word in the user's tunables copy
# (~/.config/opal/bar_tunables.slang): `opal-reload` recompiles it live.
#
# The copy is a bridge, not a config. A user copy is the *whole* module (a
# partial file does not compile), so from the moment it exists the bar
# compiles the copy and a default tuned later in the shipped module never
# reaches it; and a later module that adds a word the caustic needs makes
# the copy fail to compile, which keeps the last good bar running but puts
# the next *restart* on the baked SPIR-V, at the bottom. The real fix is
# EDGE_TOP as the shipped default (opal's queue, after the gate's step 22
# and its origin probe learn the new default); `--status` says when that
# has landed and `--drop-copy` then removes the copy — `opal-reload` reads
# a removal that persists as "back to the shipped module".
#
#   OPAL_CAUSTICS=<dir>   the shipped caustics, the source of the tunables
#                         copy when there is none (default ~/git/opal/caustics)
set -uo pipefail

bin="$HOME/.local/bin"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/topaz/panel-switch"
tunables="${XDG_CONFIG_HOME:-$HOME/.config}/opal/bar_tunables.slang"
caustics="${OPAL_CAUSTICS:-$HOME/git/opal/caustics}"
watchdogs=(topaz-panel-watchdog.timer topaz-panel-watchdog-follow.service topaz-shell-watchdog.service)
shimmed=(cosmic-panel cosmic-notifications)

say() { printf '%s\n' "$*"; }
die() { say "FAIL: $*" >&2; exit 1; }

# pids by process name, real binaries or our shims. comm is 15 chars wide, so
# compare against the truncated name and tell the two apart by the executable:
# a shim runs as bash, the real thing as itself.
procs() { # procs <name> real|shim
    local name=$1 kind=$2 short=${1:0:15} p comm exe
    for p in /proc/[0-9]*; do
        comm=$(cat "$p/comm" 2>/dev/null) || continue
        [ "$comm" = "$short" ] || continue
        exe=$(readlink -f "$p/exe" 2>/dev/null) || continue
        case "$kind" in
            real) [[ $exe != */bash ]] || continue ;;
            shim) [[ $exe == */bash ]] || continue ;;
        esac
        echo "${p#/proc/}"
    done
}

session_pid() { pgrep -o -x cosmic-session; }

session_path() {
    local pid
    pid=$(session_pid) || return 1
    tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | sed -n 's/^PATH=//p'
}

# What the session would exec for a name, given its PATH.
session_resolves() { # session_resolves <name>
    local path
    path=$(session_path) || return 1
    PATH=$path command -v "$1"
}

edge_in() { sed -nE 's/^public static const uint EDGE = (EDGE_[A-Z]+);.*/\1/p' "$1" | head -1; }
edge() { # the EDGE word in the user's tunables copy, or "none"
    [ -r "$tunables" ] && edge_in "$tunables" || echo none
}
shipped_edge() { # the EDGE word in the shipped module, or "unknown"
    [ -r "$caustics/bar_tunables.slang" ] && edge_in "$caustics/bar_tunables.slang" || echo unknown
}
copy_drift() { # lines where the copy differs from the shipped module, the EDGE line aside
    [ -r "$tunables" ] && [ -r "$caustics/bar_tunables.slang" ] || { echo "?"; return; }
    diff <(grep -v '^public static const uint EDGE = ' "$tunables") \
         <(grep -v '^public static const uint EDGE = ' "$caustics/bar_tunables.slang") | grep -c '^[<>]'
}

panel_layers() { # cosmic-panel's layer surfaces niri knows, by its entry names
    local f entries=()
    for f in "${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/com.system76.CosmicPanel/v1/entries" \
             /usr/share/cosmic/com.system76.CosmicPanel/v1/entries; do
        [ -r "$f" ] && { mapfile -t entries < <(grep -o '"[^"]*"' "$f" | tr -d '"'); break; }
    done
    [ "${#entries[@]}" -gt 0 ] || entries=(Panel Dock)
    niri msg -j layers 2>/dev/null | python3 -c '
import json, sys
want = set(sys.argv[1:])
print(" ".join(sorted({l["namespace"] for l in json.load(sys.stdin) if l["namespace"] in want})))
' "${entries[@]}"
}

bar_layer() {
    niri msg -j layers 2>/dev/null | python3 -c '
import json, sys
print("mapped" if any(l["namespace"] == "opal-bar" for l in json.load(sys.stdin)) else "absent")'
}

notify_owner() {
    busctl --user status org.freedesktop.Notifications 2>/dev/null | sed -n 's/^Comm=//p'
}

shim_up() { [ -n "$(procs "$1" shim)" ]; }
panel_gone() { [ -z "$(panel_layers)" ]; }
panel_back() { [ -n "$(panel_layers)" ]; }

wait_for() { # wait_for <seconds> <command...>: true when the command succeeds in time
    local n=$1; shift
    while [ "$n" -gt 0 ]; do
        "$@" && return 0
        sleep 1; n=$((n - 1))
    done
    "$@"
}

status() {
    local name pids s owner enabled active
    say "panel:"
    for name in "${shimmed[@]}"; do
        pids=$(procs "$name" real | tr '\n' ' ')
        s=$(procs "$name" shim | tr '\n' ' ')
        say "  $name: real ${pids:-none }| shim ${s:-none}"
    done
    say "  cosmic-panel layer surfaces: $(panel_layers | sed 's/^$/none/')"
    say "  opal-bar layer surface: $(bar_layer)"
    owner=$(notify_owner); say "  org.freedesktop.Notifications: ${owner:-nobody}"
    say "shims in $bin:"
    for name in "${shimmed[@]}"; do
        if [ -x "$bin/$name" ] && grep -q topaz-panel-switch "$bin/$name"; then
            say "  $name: present; the session resolves it to $(session_resolves "$name" || echo '(no cosmic-session)')"
        else
            say "  $name: absent; the session resolves it to $(session_resolves "$name" || echo '(no cosmic-session)')"
        fi
    done
    say "watchdogs:"
    for name in "${watchdogs[@]}"; do
        enabled=$(systemctl --user is-enabled "$name" 2>/dev/null); active=$(systemctl --user is-active "$name" 2>/dev/null)
        say "  $name: ${enabled:-missing}, ${active:-missing}"
    done
    say "bar:"
    say "  opal-bar.service: $(systemctl --user is-active opal-bar.service 2>/dev/null)"
    say "  tunables copy: $tunables — EDGE $(edge); shipped ($caustics): EDGE $(shipped_edge)"
    if [ -r "$tunables" ]; then
        say "  the copy differs from the shipped module in $(copy_drift) lines besides EDGE (0 = a pure bridge)"
        [ "$(shipped_edge)" = EDGE_TOP ] && say "  the shipped default is EDGE_TOP now: the copy is redundant — topaz-panel-switch --drop-copy"
    fi
    say "  state: $state_dir ($(ls "$state_dir" 2>/dev/null | tr '\n' ' '))"
}

write_shim() { # write_shim <name>
    cat > "$bin/$1" <<EOF
#!/usr/bin/bash
# $1 is shimmed by topaz-panel-switch: opal-bar is the panel. cosmic-session
# respawns this name when it exits, so it sleeps instead. Remove with
# \`topaz-panel-switch --undo\`, never by hand while the switch is live.
echo "$1: shimmed by topaz-panel-switch; opal-bar is the panel" >&2
while :; do sleep 86400; done
EOF
    chmod +x "$bin/$1"
}

terminate() { # terminate <pid>: TERM, five seconds, KILL
    local pid=$1 _
    kill -TERM "$pid" 2>/dev/null || return 0
    for _ in 1 2 3 4 5; do
        sleep 1
        kill -0 "$pid" 2>/dev/null || return 0
    done
    say "  $pid ignored TERM; sending KILL"
    kill -KILL "$pid" 2>/dev/null
}

switch() {
    local pid name p resolved
    pid=$(session_pid) || die "no cosmic-session in this session; nothing to switch (a plain niri session has no cosmic-panel)"
    systemctl --user is-active --quiet opal-bar.service || die "opal-bar.service is not active; there is no bar to switch to"
    [ "$(bar_layer)" = mapped ] || die "opal-bar has no layer surface on niri; fix the bar before taking the panel away"
    [ -d "$caustics" ] || [ -r "$tunables" ] || die "no shipped caustics at $caustics (set OPAL_CAUSTICS) and no tunables copy at $tunables"
    mkdir -p "$state_dir" "$bin" "$(dirname "$tunables")"

    say "1. the watchdogs that assert cosmic-panel: disabled, not masked (their files are topaz-home's copies in ~/.config/systemd/user)"
    : > "$state_dir/enabled-units"
    for name in "${watchdogs[@]}"; do
        if systemctl --user is-enabled --quiet "$name" 2>/dev/null; then
            echo "$name" >> "$state_dir/enabled-units"
        fi
        systemctl --user disable --now "$name" 2>/dev/null
        say "  $name: $(systemctl --user is-enabled "$name" 2>/dev/null), $(systemctl --user is-active "$name" 2>/dev/null)"
    done
    systemctl --user stop topaz-panel-watchdog.service 2>/dev/null
    systemctl --user reset-failed topaz-panel-watchdog.service topaz-shell-watchdog.service 2>/dev/null

    say "2. shims in $bin, where cosmic-session ($pid) looks before /usr/bin"
    for name in "${shimmed[@]}"; do
        write_shim "$name"
        resolved=$(session_resolves "$name")
        [ "$resolved" = "$bin/$name" ] || {
            rm -f "$bin/$name"
            die "the session's PATH resolves $name to ${resolved:-nothing}, not the shim; cosmic-panel would come back on the respawn. Shims removed; the watchdogs stay disabled (--undo re-enables them)."
        }
        say "  $name -> $resolved"
    done

    say "3. cosmic-panel and cosmic-notifications: stopped; cosmic-session respawns the shims"
    for name in "${shimmed[@]}"; do
        for p in $(procs "$name" real); do
            say "  $name $p: TERM"
            terminate "$p"
        done
    done
    for name in "${shimmed[@]}"; do
        if wait_for 10 shim_up "$name"; then
            say "  $name: shim running as pid $(procs "$name" shim | head -1)"
        else
            say "  WARN: no $name shim appeared within 10 s; cosmic-session may not have respawned it (check: journalctl --user -t cosmic-session -n 20)"
        fi
    done
    if wait_for 10 panel_gone; then
        say "  cosmic-panel's layer surfaces: gone"
    else
        say "  WARN: niri still lists cosmic-panel's layer surfaces ($(panel_layers))"
    fi
    say "  org.freedesktop.Notifications: $(notify_owner)"

    say "4. the bar to the top"
    if [ "$(shipped_edge)" = EDGE_TOP ] && [ ! -e "$tunables" ]; then
        say "  the shipped default is already EDGE_TOP; no copy needed"
    else
        if [ ! -e "$tunables" ]; then
            cp "$caustics/bar_tunables.slang" "$tunables"
            touch "$state_dir/tunables-created"
            say "  copied the shipped module from $caustics as a BRIDGE: the bar compiles this copy from now on, so later shipped defaults do not reach it until it is removed (--drop-copy, once the shipped default is EDGE_TOP)"
        fi
        sed -i -E 's/^(public static const uint EDGE = )EDGE_(TOP|BOTTOM);/\1EDGE_TOP;/' "$tunables"
        [ "$(edge)" = EDGE_TOP ] || die "EDGE is '$(edge)' after the edit; the tunables module's EDGE line is not where this script expects it"
        say "  EDGE_TOP written to $tunables; opal-reload recompiles (a few seconds on the laptop's GPU, the bar re-anchors itself)"
    fi

    say "done. cosmic-panel is disabled, not removed: --undo puts it back. After the next login run: topaz-panel-switch --status"
}

undo() {
    local name p
    mkdir -p "$state_dir"
    say "1. the bar back to the bottom"
    if [ "$(shipped_edge)" = EDGE_BOTTOM ] && [ -e "$state_dir/tunables-created" ]; then
        rm -f "$tunables" "$state_dir/tunables-created"
        say "  the bridge copy removed; opal-reload returns the bar to the shipped module (EDGE_BOTTOM) within a second"
    elif [ -r "$tunables" ]; then
        sed -i -E 's/^(public static const uint EDGE = )EDGE_(TOP|BOTTOM);/\1EDGE_BOTTOM;/' "$tunables"
        say "  EDGE_BOTTOM written to $tunables (a copy that was not this script's, or the shipped default is EDGE_TOP now)"
    elif [ "$(shipped_edge)" = EDGE_TOP ]; then
        cp "$caustics/bar_tunables.slang" "$tunables"
        sed -i -E 's/^(public static const uint EDGE = )EDGE_(TOP|BOTTOM);/\1EDGE_BOTTOM;/' "$tunables"
        touch "$state_dir/tunables-created"
        say "  the shipped default is EDGE_TOP, so a copy with EDGE_BOTTOM moves the bar out of cosmic-panel's way: $tunables"
    fi

    say "2. the shims out of $bin"
    for name in "${shimmed[@]}"; do
        if [ -e "$bin/$name" ] && grep -q topaz-panel-switch "$bin/$name"; then
            rm -f "$bin/$name"; say "  $name: removed"
        else
            say "  $name: no shim of ours there"
        fi
    done

    say "3. the sleeping shims stopped; cosmic-session respawns the real cosmic-panel and cosmic-notifications"
    for name in "${shimmed[@]}"; do
        for p in $(procs "$name" shim); do
            say "  $name shim $p: TERM"
            terminate "$p"
        done
    done
    if wait_for 20 panel_back; then
        say "  cosmic-panel's layer surfaces: $(panel_layers)"
    else
        say "  WARN: cosmic-panel has not mapped within 20 s (journalctl --user -t cosmic-session -n 20; or: niri msg action spawn -- cosmic-panel)"
    fi

    say "4. the watchdogs back"
    if [ -r "$state_dir/enabled-units" ]; then
        while read -r name; do
            [ -n "$name" ] || continue
            systemctl --user enable --now "$name" 2>/dev/null
            say "  $name: $(systemctl --user is-enabled "$name" 2>/dev/null), $(systemctl --user is-active "$name" 2>/dev/null)"
        done < "$state_dir/enabled-units"
        rm -f "$state_dir/enabled-units"
    else
        say "  no record of what was enabled; enabling the three"
        for name in "${watchdogs[@]}"; do
            systemctl --user enable --now "$name" 2>/dev/null
        done
    fi
    say "done. cosmic-panel is the panel again; the bar runs beside it at the bottom."
}

drop_copy() {
    [ -e "$tunables" ] || { say "no tunables copy at $tunables; nothing to drop"; return 0; }
    [ "$(shipped_edge)" = EDGE_TOP ] || die "the shipped default is $(shipped_edge), not EDGE_TOP; removing the copy would put the bar at the bottom. Flip the shipped default first (opal: caustics/bar_tunables.slang)."
    local drift; drift=$(copy_drift)
    [ "$drift" = 0 ] || die "the copy differs from the shipped module in $drift lines besides EDGE; it carries more than the bridge — compare before removing: diff $tunables $caustics/bar_tunables.slang"
    rm -f "$tunables" "$state_dir/tunables-created"
    say "removed $tunables; opal-reload returns the bar to the shipped module (EDGE_TOP) within a second"
}

case "${1:-}" in
    "") switch ;;
    --undo) undo ;;
    --status) status ;;
    --drop-copy) drop_copy ;;
    *) say "usage: topaz-panel-switch [--undo|--status|--drop-copy]" >&2; exit 2 ;;
esac
