#!/usr/bin/bash
# Snapshot the niri window layout into a spawn-at-startup include so the
# next login reopens the same apps in the same order. Windows are listed
# workspace by workspace, column by column, so launch order (and hence
# column order, for apps that start at similar speeds) mirrors the
# layout. Only app identities come back: niri has no session-management
# protocol, and neither does cosmic-session, so window contents do not.
#
# Exits quietly when not running under niri, so the timer is harmless in
# the stock COSMIC session. Writes only when the snapshot changed, so
# niri's config watcher is not woken every tick.

set -euo pipefail

out="${TOPAZ_SESSION_FILE:-$HOME/.config/niri/topaz-session.kdl}"

# cosmic-session imports WAYLAND_DISPLAY into the systemd user manager
# but not NIRI_SOCKET, so under the timer the socket has to be found by
# its name: niri.<wayland display>.<niri pid>.sock, pid still alive
# (stale sockets from earlier sessions linger until reboot).
if [ -z "${NIRI_SOCKET:-}" ] || [ ! -S "$NIRI_SOCKET" ]; then
    unset NIRI_SOCKET
    for sock in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/niri."${WAYLAND_DISPLAY:-wayland-1}".*.sock; do
        [ -S "$sock" ] || continue
        pid=${sock%.sock}; pid=${pid##*.}
        if [ -d "/proc/$pid" ]; then
            export NIRI_SOCKET="$sock"
            break
        fi
    done
fi
[ -n "${NIRI_SOCKET:-}" ] || exit 0

# Right after login the previous snapshot is still being replayed; a
# tick then would capture a half-open session and overwrite the real one.
# Leave the snapshot alone until niri has been up for the settle period.
settle="${TOPAZ_SESSION_SETTLE:-180}"
pid=${NIRI_SOCKET%.sock}; pid=${pid##*.}
if [ -r "/proc/$pid/stat" ]; then
    start_ticks=$(awk '{print $22}' "/proc/$pid/stat")
    uptime_s=$(cut -d' ' -f1 /proc/uptime)
    age=$(awk -v u="$uptime_s" -v s="$start_ticks" -v hz="$(getconf CLK_TCK)" 'BEGIN { print int(u - s / hz) }')
    [ "$age" -ge "$settle" ] || exit 0
fi

windows=$(niri msg -j windows) || exit 0
# An empty session is more likely "just logged in" than "deliberately
# closed everything": keep the previous snapshot rather than erase it.
[ "$(jq length <<< "$windows")" -gt 0 ] || exit 0
workspaces=$(niri msg -j workspaces) || exit 0

# app-id -> desktop entry id. Tried in order: an entry named after the
# app-id, an entry whose StartupWMClass names it (Electron apps such as
# Discord), then a case-insensitive match on the reverse-DNS tail.
declare -A resolved
resolve() {
    local app="$1" d f base
    [ -n "$app" ] || return 1
    if [ -n "${resolved[$app]:-}" ]; then
        echo "${resolved[$app]}"
        return 0
    fi
    local -a dirs=()
    IFS=: read -r -a data_dirs <<< "${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    for d in "${data_dirs[@]}"; do
        [ -d "$d/applications" ] && dirs+=("$d/applications")
    done
    [ "${#dirs[@]}" -gt 0 ] || return 1
    for d in "${dirs[@]}"; do
        if [ -f "$d/$app.desktop" ]; then
            resolved[$app]="$app"
            echo "$app"
            return 0
        fi
    done
    f=$(grep -lsx "StartupWMClass=$app" "${dirs[@]/%//*.desktop}" 2>/dev/null | head -1 || :)
    if [ -z "$f" ]; then
        f=$(find "${dirs[@]}" -maxdepth 1 -iname "*.$app.desktop" 2>/dev/null | head -1 || :)
    fi
    [ -n "$f" ] || return 1
    base=$(basename "$f" .desktop)
    resolved[$app]="$base"
    echo "$base"
}

# Order: workspace index, then scrolling-layout column and row; floating
# windows come after the tiled ones of their workspace.
ordered=$(jq -rn --argjson w "$windows" --argjson ws "$workspaces" '
    ($ws | map({key: (.id|tostring), value: .idx}) | from_entries) as $idx
    | $w
    | map(. + {ws: ($idx[(.workspace_id|tostring)] // 9999),
               col: (.layout.pos_in_scrolling_layout[0] // 9999),
               row: (.layout.pos_in_scrolling_layout[1] // 9999)})
    | sort_by(.ws, .col, .row)
    | .[] | .app_id // ""')

content="// Generated by topaz-session-snapshot; edits are overwritten.
// Included from config.kdl to reopen the last session's apps at login.
"
skipped=()
while IFS= read -r app; do
    [ -n "$app" ] || continue
    if entry=$(resolve "$app"); then
        content+="spawn-at-startup \"gtk-launch\" \"$entry\"
"
    else
        skipped+=("$app")
    fi
done <<< "$ordered"

if [ "${#skipped[@]}" -gt 0 ]; then
    echo "no desktop entry for: ${skipped[*]} (not restored)" >&2
fi

if [ -f "$out" ] && [ "$(cat "$out")" = "${content%$'\n'}" ]; then
    exit 0
fi
mkdir -p "$(dirname "$out")"
tmp=$(mktemp "$(dirname "$out")/.topaz-session.XXXXXX")
printf '%s' "$content" > "$tmp"
mv -f "$tmp" "$out"
