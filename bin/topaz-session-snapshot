#!/usr/bin/bash
# Snapshot the niri window layout so the next login can reopen the same
# apps on the same workspaces, in the same column order. Writes a plan to
# $XDG_STATE_HOME/topaz/session.json (one entry per window: desktop entry,
# output, workspace index, column, floating) and a one-line include,
# ~/.config/niri/topaz-session.kdl, that spawns topaz-session-restore at
# startup to replay it. Only app identities come back: niri has no
# session-management protocol, and neither does cosmic-session, so window
# contents do not.
#
# Exits quietly when not running under niri, so the timer is harmless in
# the stock COSMIC session. Writes only when the snapshot changed.

set -euo pipefail

plan="${TOPAZ_SESSION_PLAN:-${XDG_STATE_HOME:-$HOME/.local/state}/topaz/session.json}"
include="${TOPAZ_SESSION_FILE:-$HOME/.config/niri/topaz-session.kdl}"

# cosmic-session imports WAYLAND_DISPLAY into the systemd user manager
# but not NIRI_SOCKET, so under the timer the socket has to be found by
# its name: niri.<wayland display>.<niri pid>.sock, pid still alive
# (stale sockets from earlier sessions linger until reboot).
if [ -z "${NIRI_SOCKET:-}" ] || [ ! -S "$NIRI_SOCKET" ]; then
    unset NIRI_SOCKET
    for sock in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/niri."${WAYLAND_DISPLAY:-wayland-1}".*.sock; do
        [ -S "$sock" ] || continue
        pid=${sock%.sock}; pid=${pid##*.}
        if [ -d "/proc/$pid" ]; then
            export NIRI_SOCKET="$sock"
            break
        fi
    done
fi
[ -n "${NIRI_SOCKET:-}" ] || exit 0

# Right after login the previous snapshot is still being replayed; a
# tick then would capture a half-open session and overwrite the real one.
# Leave the snapshot alone until niri has been up for the settle period.
settle="${TOPAZ_SESSION_SETTLE:-180}"
pid=${NIRI_SOCKET%.sock}; pid=${pid##*.}
if [ -r "/proc/$pid/stat" ]; then
    start_ticks=$(awk '{print $22}' "/proc/$pid/stat")
    uptime_s=$(cut -d' ' -f1 /proc/uptime)
    age=$(awk -v u="$uptime_s" -v s="$start_ticks" -v hz="$(getconf CLK_TCK)" 'BEGIN { print int(u - s / hz) }')
    [ "$age" -ge "$settle" ] || exit 0
fi

windows=$(niri msg -j windows) || exit 0
# An empty session is more likely "just logged in" than "deliberately
# closed everything": keep the previous snapshot rather than erase it.
[ "$(jq length <<< "$windows")" -gt 0 ] || exit 0
workspaces=$(niri msg -j workspaces) || exit 0

# app-id -> desktop entry id. Tried in order: an entry named after the
# app-id, an entry whose StartupWMClass names it (Electron apps such as
# Discord), then a case-insensitive match on the reverse-DNS tail.
declare -A resolved
resolve() {
    local app="$1" d f base
    [ -n "$app" ] || return 1
    if [ -n "${resolved[$app]:-}" ]; then
        echo "${resolved[$app]}"
        return 0
    fi
    local -a dirs=()
    IFS=: read -r -a data_dirs <<< "${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    for d in "${data_dirs[@]}"; do
        [ -d "$d/applications" ] && dirs+=("$d/applications")
    done
    [ "${#dirs[@]}" -gt 0 ] || return 1
    for d in "${dirs[@]}"; do
        if [ -f "$d/$app.desktop" ]; then
            resolved[$app]="$app"
            echo "$app"
            return 0
        fi
    done
    f=$(grep -lsx "StartupWMClass=$app" "${dirs[@]/%//*.desktop}" 2>/dev/null | head -1 || :)
    if [ -z "$f" ]; then
        f=$(find "${dirs[@]}" -maxdepth 1 -iname "*.$app.desktop" 2>/dev/null | head -1 || :)
    fi
    [ -n "$f" ] || return 1
    base=$(basename "$f" .desktop)
    resolved[$app]="$base"
    echo "$base"
}

# One line per window: workspace index (per output), scrolling-layout
# column and row, floating and focus flags. Ordered by workspace, then
# column, then row; floating windows come after the tiled ones of their
# workspace. The order doubles as launch order at restore.
ordered=$(jq -cn --argjson w "$windows" --argjson ws "$workspaces" '
    ($ws | map({key: (.id|tostring), value: {idx, output}}) | from_entries) as $wsmap
    | $w
    | map(select(.app_id != null and .app_id != "")
          | ($wsmap[(.workspace_id|tostring)] // {}) as $w
          | {app: .app_id,
             output: ($w.output // null),
             ws: ($w.idx // 9999),
             col: (.layout.pos_in_scrolling_layout[0] // 9999),
             row: (.layout.pos_in_scrolling_layout[1] // 9999),
             floating: .is_floating,
             focused: .is_focused})
    | sort_by(.ws, .col, .row)
    | .[]')

entries=""
skipped=()
while IFS= read -r win; do
    [ -n "$win" ] || continue
    app=$(jq -r .app <<< "$win")
    if entry=$(resolve "$app"); then
        entries+="$(jq -c --arg e "$entry" '. + {entry: $e}' <<< "$win")"$'\n'
    else
        skipped+=("$app")
    fi
done <<< "$ordered"

if [ "${#skipped[@]}" -gt 0 ]; then
    echo "no desktop entry for: ${skipped[*]} (not restored)" >&2
fi
[ -n "$entries" ] || exit 0

content=$(jq -sc '{windows: ., focused: (map(.focused) | index(true))}' <<< "$entries")

write_if_changed() {
    local path="$1" body="$2" tmp
    if [ -f "$path" ] && [ "$(cat "$path")" = "$body" ]; then
        return 0
    fi
    mkdir -p "$(dirname "$path")"
    tmp=$(mktemp "$(dirname "$path")/.$(basename "$path").XXXXXX")
    printf '%s\n' "$body" > "$tmp"
    mv -f "$tmp" "$path"
}

write_if_changed "$plan" "$content"
write_if_changed "$include" "// Generated by topaz-session-snapshot; edits are overwritten.
// Included from config.kdl: replays the last session's window layout at login.
spawn-at-startup \"$HOME/.local/bin/topaz-session-restore\""
